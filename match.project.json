{
  "name": "hyper-tag-match",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "Server": {
        "$path": "src/server",
        "AdminService": {
          "$path": "src/serverlib/AdminService.lua"
        },
        "PlayerDataStore": {
          "$path": "src/serverlib/PlayerDataStore.lua"
        }
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "Workspace": {
      "$className": "Workspace",
      "$properties": {},
      "$ignoreUnknownInstances": true,
      "Map": {
        "$path": "src/workspace/Map.model.json"
      },
      "ItemSpawns": {
        "$path": "src/workspace/ItemSpawns.model.json"
      }
    }
  }
}